HSK_RPC_URL=https://mainnet.hsk.xyz

# contracts/script/Deploy.s.sol — never commit real values
DEPLOYER_PRIVATE_KEY=
ATTESTOR_ADDRESS=
GUARD_OWNER=
# Optional overrides (e.g. testnet 133)
SWAP_ROUTER02=
V3_FACTORY=

# apps/web (POST /api/quote) — the key is never logged
ATTESTOR_PRIVATE_KEY=
GUARD_ADDRESS=
HSK_CHAIN_ID=177
QUOTE_TTL_SECONDS=60
# Per-IP rate limit for /api/quote (in-memory; shared via Upstash Redis REST when both vars are set)
RATE_LIMIT_PER_MINUTE=30
# In-memory only (no Upstash): ceiling across all IPs per instance
RATE_LIMIT_GLOBAL_PER_MINUTE=300
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# packages/mcp + apps/agent
PREFLIGHT_API_URL=http://localhost:3000
ROUTER_ADDRESS=
# Agent key: only for sending txs (MCP also needs PREFLIGHT_EXECUTE=1; agent needs --live)
AGENT_PRIVATE_KEY=
PREFLIGHT_EXECUTE=
# apps/agent dry-run without a key
AGENT_ADDRESS=
AGENT_CAPITAL_USD=100
AGENT_LOG=agent-reasons.jsonl
# --live stops after this many consecutive revert/rejected/error ticks
AGENT_MAX_CONSECUTIVE_FAILURES=3
# MCP guarded_swap: max quote notional (USD)
PREFLIGHT_MAX_USD=100
# Optional LLM sizing/reason; without a key the deterministic fallback is used
ANTHROPIC_API_KEY=
AGENT_LLM_MODEL=claude-haiku-5-5
